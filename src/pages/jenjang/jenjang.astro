
---
import MainLayout from "../../components/layout/MainLayout.astro";
import Jenjang from "../../components/pages/Jenjang.astro";

export function getStaticPaths() {
  return [
    { params: { jenjang: "sd" } },
    { params: { jenjang: "smp" } },
    { params: { jenjang: "sma" } },
  ];
}

const { jenjang } = Astro.params;

const titles: Record<string, string> = {
  sd: "SD — Explore",
  smp: "SMP — Create",
  sma: "SMA — Innovate",
};

const title = titles[jenjang ?? "sd"] ?? titles.sd;
---

<MainLayout title={`${title} | Sekolah Teknologi Alfatihah`}>
  <Jenjang />
</MainLayout>

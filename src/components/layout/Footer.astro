
---
import "../../styles/layout/footer.css";
import logoSekolah from "../../assets/logo/logo-sekolah-teknologi.png";

const navigation = [
  { label: "Beranda", href: "/" },
  { label: "Tentang Kami", href: "/#tentang-kami" },
  { label: "Jenjang", href: "/#jenjang" },
  { label: "Program", href: "/#program-unggulan" },
  { label: "Fasilitas", href: "/#lingkungan-belajar" },
];

const levels = [
  { label: "SD", href: "/#jenjang" },
  { label: "SMP", href: "/#jenjang" },
  { label: "SMA", href: "/#jenjang" },
];

const programs = [
  { label: "Program Unggulan", href: "/#program-unggulan" },
  { label: "Ekstrakurikuler", href: "/#ekstrakurikuler" },
];
---

<footer class="st-footer">
  <div class="st-footer-container">

    <div class="st-footer-grid">

      <!-- LOGO DAN DESKRIPSI -->
      <div class="st-footer-brand">

        <a
          href="/"
          class="st-footer-logo"
          aria-label="Sekolah Teknologi - Beranda"
        >
          <img
            src={logoSekolah.src}
            alt="Logo Sekolah Teknologi"
            class="st-footer-logo-image"
            loading="lazy"
          />
        </a>

        <p class="st-footer-description">
          Pendidikan teknologi untuk membentuk generasi muda
          yang terampil, berkarakter, dan berdampak bagi masyarakat.
        </p>

        <!-- SOSIAL MEDIA -->
        <div class="st-footer-social">

          <!-- INSTAGRAM -->
          <a
            href="https://instagram.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="5"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle
                cx="12"
                cy="12"
                r="4"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle
                cx="17.5"
                cy="6.5"
                r="1"
                fill="currentColor"
              />
            </svg>
          </a>

          <!-- YOUTUBE -->
          <a
            href="https://youtube.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect
                x="2"
                y="5"
                width="20"
                height="14"
                rx="4"
                fill="currentColor"
              />
              <path
                d="M10 9L16 12L10 15V9Z"
                fill="white"
              />
            </svg>
          </a>

          <!-- LINKEDIN -->
          <a
            href="https://linkedin.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M5 3a2 2 0 100 4 2 2 0 000-4ZM3.5 9h3V21h-3V9ZM9 9h3v1.6c.7-1.1 1.8-1.9 3.6-1.9 3.2 0 4.4 2 4.4 5.2V21h-3v-6.4c0-1.7-.4-2.9-2.2-2.9-1.7 0-2.8 1.2-2.8 3V21H9V9Z"
              />
            </svg>
          </a>

        </div>
      </div>

      <!-- NAVIGASI -->
      <nav
        class="st-footer-column"
        aria-label="Navigasi footer"
      >
        <h3>Navigasi</h3>

        <ul>
          {navigation.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- JENJANG -->
      <nav
        class="st-footer-column"
        aria-label="Jenjang pendidikan"
      >
        <h3>Jenjang</h3>

        <ul>
          {levels.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- PROGRAM -->
      <nav
        class="st-footer-column"
        aria-label="Program sekolah"
      >
        <h3>Program</h3>

        <ul>
          {programs.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- KONTAK -->
      <div class="st-footer-column st-footer-contact">
        <h3>Kontak</h3>

        <ul>
          <li>
            <a
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                class="st-footer-contact-icon"
                aria-hidden="true"
              >
                ◉
              </span>
              Hubungi kami via WhatsApp
            </a>
          </li>

          <li>
            <a href="#lokasi-sekolah">
              <span
                class="st-footer-contact-icon"
                aria-hidden="true"
              >
                
              </span>
             
            </a>
          </li>

 
        </ul>
      </div>

    </div>

    <!-- COPYRIGHT -->
    <div class="st-footer-bottom">

      <p>
        © {new Date().getFullYear()} Sekolah Teknologi.
        All rights reserved.
      </p>

      <div class="st-footer-legal">
        <a href="/kebijakan-privasi">
          Kebijakan Privasi
        </a>

        <a href="/syarat-ketentuan">
          Syarat &amp; Ketentuan
        </a>
      </div>

    </div>
  </div>
</footer>

    "M9 21v-7h6v7",
    "M2 21h20",
    "M12 2v4",
  ],

  users: [
    "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z",
    "M2 21v-2a7 7 0 0 1 14 0v2H2Z",
    "M17 4a4 4 0 0 1 0 7",
    "M19 14a6 6 0 0 1 3 5v2h-4",
  ],

  file: [

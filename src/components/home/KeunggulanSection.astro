---

<section
  class="keunggulan-section"
  aria-labelledby="keunggulan-title"
>
  <div class="keunggulan-container">

    <!-- HEADER SECTION -->
    <div class="keunggulan-heading">

      <p class="keunggulan-eyebrow">
        KENAPA SEKOLAH TEKNOLOGI
      </p>

      <h2 id="keunggulan-title">
        Kenapa Orang Tua Memilih <span>Sekolah Teknologi</span>
      </h2>

      <p class="keunggulan-intro">
        Banyak sekolah menambahkan komputer ke kurikulumnya.
        Kami membangun kurikulum dari cara berpikir teknologi
        itu sendiri: bertanya, mencoba, gagal, memperbaiki,
        lalu berbagi manfaat.
      </p>

    </div>

    <!-- GRID 8 KARTU KEUNGGULAN -->
    <div class="keunggulan-grid">

      {keunggulan.map((item) => (
        <article
          class={`keunggulan-card keunggulan-card--${item.warna}`}
        >

          <!-- NOMOR DAN IKON -->
          <div class="keunggulan-card-icons">

            <span class="keunggulan-number">
              {item.nomor}
            </span>

            <div
              class="keunggulan-icon"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {iconPaths[item.ikon].map((path: string) => (
                  <path d={path} />
                ))}
              </svg>
            </div>

          </div>

          <!-- JUDUL KARTU -->
          <h3>{item.judul}</h3>

          <!-- DESKRIPSI KARTU -->
          <p>{item.deskripsi}</p>

        </article>
      ))}

    </div>

  </div>
</section>


---
import "../../styles/pages/program.css";

const programs = [
  {
    number: "01",
    icon: "💻",
    title: "Coding & Computational Thinking",
    description:
      "Anak belajar berpikir seperti pembuat program: memecah masalah, menyusun langkah, menemukan kesalahan, dan memperbaikinya. Di SD lewat permainan dan blok visual, di SMP dengan bahasa pemrograman teks, di SMA dalam proyek perangkat lunak yang dipakai orang lain.",
    levels: ["SD", "SMP", "SMA"],
  },
  {
    number: "02",
    icon: "🤖",
    title: "Robotika & Elektronika",
    description:
      "Siswa merakit, memprogram, dan menguji robot serta perangkat sederhana. Kegagalan di meja kerja adalah bagian dari pelajaran, dan setiap tim mempresentasikan hasil rakitannya pada akhir semester.",
    levels: ["SD kelas 4–6", "SMP", "SMA"],
  },
  {
    number: "03",
    icon: "🎨",
    title: "Desain & Media Digital",
    description:
      "Dari menggambar digital hingga memproduksi video dan animasi. Siswa belajar menyampaikan pesan dengan jujur dan estetis, serta memahami tanggung jawab sebagai pembuat konten.",
    levels: ["SD kelas 4–6", "SMP", "SMA"],
  },
  {
    number: "04",
    icon: "🔬",
    title: "Sains Eksperimental",
    description:
      "Setiap konsep IPA yang bisa dipraktikkan, dipraktikkan. Laboratorium dan halaman sekolah menjadi tempat mengamati, mengukur, dan mencatat, bukan hanya menghafal rumus.",
    levels: ["SD", "SMP", "SMA"],
  },
  {
    number: "05",
    icon: "📖",
    title: "Tahfidz & Tahsin",
    description:
      "Bimbingan harian dengan target hafalan bertahap per jenjang, disertai murajaah rutin agar hafalan terjaga. Bacaan diperbaiki sejak awal sehingga anak membaca Al-Qur’an dengan benar dan percaya diri.",
    levels: ["SD", "SMP", "SMA"],
  },
  {
    number: "06",
    icon: "🌍",
    title: "English for Tech",
    description:
      "Bahasa Inggris dipraktikkan sebagai bahasa kerja di kelas teknologi: membaca petunjuk, menulis deskripsi karya, dan mempresentasikan proyek. Bahasa dipelajari karena dibutuhkan, bukan sekadar untuk ujian.",
    levels: ["SD", "SMP", "SMA"],
  },
  {
    number: "07",
    icon: "🚀",
    title: "Kewirausahaan Digital",
    description:
      "Siswa membuat produk atau jasa kecil, memasarkannya secara digital, dan mengelola hasilnya. Puncaknya adalah Market Day, di mana orang tua dan masyarakat menjadi pembeli sungguhan.",
    levels: ["SMP", "SMA"],
  },
  {
    number: "08",
    icon: "🤝",
    title: "Proyek Sosial Berdampak",
    description:

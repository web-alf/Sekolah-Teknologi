    levels: ["SD", "SMP", "SMA"],
  },
  {
    number: "09",
    icon: "🏆",
    title: "Exhibition Day",
    description:
      "Pameran karya semesteran di hadapan orang tua, mentor, dan tamu undangan. Siswa berlatih menjelaskan proses, bukan hanya memamerkan hasil.",
    levels: ["SD", "SMP", "SMA"],
  },
  {
    number: "10",
    icon: "👨‍🏫",
    title: "Mentor Praktisi",
    description:
      "Kelas tamu dan bimbingan proyek dari praktisi entitas media, teknologi, penerbitan, dan bisnis di ekosistem Alfatihah & Almadinah Group.",
    levels: ["SMP", "SMA"],
  },
  {
    number: "11",
    icon: "🏢",
    title: "Magang Ekosistem",
    description:
      "Praktik kerja terbimbing di entitas mitra selama [durasi], dengan laporan dan penilaian yang menjadi bagian portofolio.",
    levels: ["SMA"],
  },
];

const extracurriculars = [
  {
    icon: "💻",
    category: "Teknologi",
    activities: [
      "Klub Coding",
      "Klub Robotika",
      "Klub Game Developer",
      "Klub Konten Kreator",
    ],
  },
  {
    icon: "🔬",
    category: "Sains & Literasi",
    activities: [
      "Klub Sains",
      "Klub Menulis & Jurnalistik Digital",
      "English Club",
    ],
  },
  {
    icon: "📖",
    category: "Keagamaan",
    activities: [
      "Tahfidz Intensif",
      "Tilawah & Kaligrafi",
    ],
  },
  {
    icon: "⚽",
    category: "Seni & Olahraga",
    activities: [
      "Seni Rupa Digital",
      "Musik Perkusi",
      "Panahan",
      "Futsal",
      "Bela Diri",
    ],
  },
  {
    icon: "🌟",
    category: "Kepemimpinan",
    activities: [
      "Pramuka",

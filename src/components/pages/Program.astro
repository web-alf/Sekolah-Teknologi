---

<div class="program-page">

  <!-- HERO HALAMAN PROGRAM -->
  <section class="program-page-hero" id="program">
    <div class="program-page-container">

      <p class="program-page-eyebrow">
        PROGRAM UNGGULAN & EKSTRAKURIKULER
      </p>

      <h1>
        Belajar yang Terasa Nyata, {""}
        <span>Setiap Minggu.</span>
      </h1>

      <p class="program-page-hero-description">
        Program di Sekolah Teknologi dirancang agar setiap
        pekan anak pulang membawa sesuatu yang bisa diceritakan:
        kode yang akhirnya berjalan, robot yang bergerak,
        ayat yang selesai dihafal, atau ide yang mulai berbentuk.
        Berikut program yang berjalan lintas jenjang,
        dengan kedalaman yang disesuaikan usia.
      </p>

      <div class="program-page-hero-actions">
        <a
          href="#program-unggulan"
          class="program-page-btn-primary"
        >
          Jelajahi Program
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="#ekstrakurikuler"
          class="program-page-btn-secondary"
        >
          Lihat Ekstrakurikuler
        </a>
      </div>

    </div>
  </section>

  <!-- SEMUA PROGRAM UNGGULAN -->
  <section
    class="program-page-section"
    id="program-unggulan"
    aria-labelledby="program-page-title"
  >
    <div class="program-page-container">

      <div class="program-page-section-heading">
        <p class="program-page-section-label">
          PEMBELAJARAN BERBASIS PENGALAMAN
        </p>

        <h2 id="program-page-title">
          Program <span>Unggulan</span>
        </h2>

        <p>
          Dari keterampilan teknologi hingga pembentukan
          karakter, setiap program menghubungkan
          pengetahuan dengan pengalaman nyata.
        </p>
      </div>

      <div class="program-page-grid">
        {programs.map((program) => (
          <article class="program-page-card">

            <div class="program-page-card-top">
              <span
                class="program-page-card-icon"
                aria-hidden="true"
              >
                {program.icon}
              </span>

              <span class="program-page-card-number">
                {program.number}
              </span>
            </div>

            <h3>{program.title}</h3>

            <p class="program-page-card-description">
              {program.description}
            </p>

            <div class="program-page-card-footer">
              <span class="program-page-level-label">
                TERSEDIA UNTUK
              </span>

              <div class="program-page-levels">
                {program.levels.map((level) => (
                  <span class="program-page-level-badge">
                    {level}
                  </span>
                ))}
              </div>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- EKSTRAKURIKULER -->
  <section
    class="program-page-extracurricular-section"
    id="ekstrakurikuler"
    aria-labelledby="program-page-extra-title"
  >
    <div class="program-page-container">

      <div class="program-page-section-heading">
        <p class="program-page-section-label">
          TEMUKAN MINAT, KEMBANGKAN BAKAT
        </p>

        <h2 id="program-page-extra-title">
          Ekstrakurikuler
        </h2>

        <p>
          Ekstrakurikuler dipilih siswa sesuai minat,
          berjalan setiap Jumat, dan wajib diikuti
          minimal satu kegiatan per semester.
        </p>
      </div>

      <div class="program-page-extra-grid">
        {extracurriculars.map((group) => (
          <article class="program-page-extra-card">

            <div class="program-page-extra-heading">
              <span
                class="program-page-extra-icon"
                aria-hidden="true"
              >
                {group.icon}
              </span>

              <h3>{group.category}</h3>
            </div>

            <ul class="program-page-extra-list">
              {group.activities.map((activity) => (
                <li>{activity}</li>
              ))}
            </ul>

          </article>
        ))}
      </div>

      <div class="program-page-extra-note">
        <span
          class="program-page-note-icon"
          aria-hidden="true"
        >
          📅
        </span>

        <div>
          <h3>Jumat, Hari Eksplorasi Minat</h3>

          <p>
            Setiap siswa memilih ekstrakurikuler
            sesuai minat dan mengikuti minimal
            satu kegiatan setiap semester.
          </p>
        </div>
      </div>

    </div>
  </section>

</div>
